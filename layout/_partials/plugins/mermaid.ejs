<script>
  Fluid.utils.createScript('<%= url_join(theme.static_prefix.mermaid, 'mermaid.min.js') %>', function() {
    mermaid.initialize({ startOnLoad: false });
    Fluid.utils.createScript('<%= url_join(theme.static_prefix.internal_js, 'mermaid.js') %>', function() {
      Fluid.initMermaid(<%- JSON.stringify(theme.post.mermaid.options || {}).replace(/</g, '\u003c') %>, <%= theme.post.mermaid.auto_theme !== false %>);
    });
  });
</script>
