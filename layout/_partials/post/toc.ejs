<div id="toc" data-toc-script="<%= url_join(theme.static_prefix.tocbot, 'tocbot.min.js') %>">
  <p class="toc-header">
    <i class="iconfont icon-list" aria-hidden="true"></i>
    <span><%- __('post.toc') %></span>
  </p>
  <nav class="toc-body" id="toc-body" aria-label="<%= __('post.toc') %>"></nav>
</div>

<button id="mobile-toc-toggle" class="mobile-toc-toggle d-lg-none" type="button" hidden
        aria-controls="mobile-toc-dialog" aria-expanded="false" aria-haspopup="dialog">
  <i class="iconfont icon-list" aria-hidden="true"></i> <%= __('post.toc') %>
</button>
<div id="mobile-toc-dialog" class="modal" tabindex="-1" role="dialog"
     aria-modal="true" aria-labelledby="mobile-toc-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable" role="document">
    <div class="modal-content">
      <div class="modal-header text-center">
        <h4 id="mobile-toc-title" class="modal-title w-100 font-weight-bold"><%= __('post.toc') %></h4>
        <button type="button" class="close" data-dismiss="modal"
                aria-label="<%= __('ui.close') === 'ui.close' ? 'Close' : __('ui.close') %>">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body mx-3"></div>
    </div>
  </div>
</div>

<%
import_script(js_ex(theme.static_prefix.internal_js, 'toc.js'))
%>
