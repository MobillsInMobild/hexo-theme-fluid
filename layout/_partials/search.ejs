<div class="modal fade" id="modalSearch" tabindex="-1" role="dialog" aria-labelledby="local-search-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header search-header">
        <h4 id="local-search-title" class="sr-only"><%= __('search.title') %></h4>
        <label class="sr-only" for="local-search-input"><%= __('search.keyword') %></label>
        <i class="iconfont icon-search" aria-hidden="true"></i>
        <input type="search" id="local-search-input" autocomplete="off" spellcheck="false"
               placeholder="<%= __('search.keyword') %>" aria-describedby="local-search-status" aria-controls="local-search-result">
        <button type="button" id="local-search-close" class="close" data-dismiss="modal" aria-label="<%= __('ui.close') === 'ui.close' ? 'Close' : __('ui.close') %>">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body search-body">
        <p id="local-search-status" role="status" aria-live="polite" aria-atomic="true"></p>
        <div id="local-search-result" aria-busy="false"></div>
      </div>
    </div>
  </div>
</div>
