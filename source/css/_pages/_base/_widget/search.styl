#local-search-result
  .search-list-title
    border-left 3px solid #0d47a1

  .search-list-content
    padding 0 1.25rem

  .search-word
    color orangered

  .search-action
    min-height 44px

    &:focus-visible
      outline 2px solid var(--link-hover-color)
      outline-offset 3px
      box-shadow none
