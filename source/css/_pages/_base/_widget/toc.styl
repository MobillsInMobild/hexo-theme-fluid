#toc
  visibility hidden

.toc-header
  margin-bottom .5rem
  font-weight bold
  line-height 1.2

  &, & > i
    font-size 1.25rem

.toc-body
  max-height 75vh
  overflow-y auto
  overflow -moz-scrollbars-none
  -ms-overflow-style none

  ol
    list-style none
    padding-inline-start 1rem

  &::-webkit-scrollbar
    display none

.tocbot-list
  position relative

  ol
    list-style none
    padding-left 1rem

  a
    font-size 0.95rem

  ol a
    font-size 0.85rem

.tocbot-link
  color var(--text-color)

.toc-toggle
  display inline-block
  width .7rem
  text-align center
  margin-right .15rem
  cursor pointer
  user-select none
  color var(--text-color)
  font-size .9rem
  line-height 1
  transition transform .2s ease-in-out

  &.toc-toggle-collapsed
    transform rotate(0deg)

  &.toc-toggle-expanded
    transform rotate(90deg)

  &.toc-toggle-placeholder
    visibility hidden
    pointer-events none
    cursor default
    transform none


.tocbot-active-link
  font-weight bold
  color var(--link-hover-color)

.tocbot-is-collapsed
  max-height 0

.tocbot-is-collapsible
  overflow hidden
  transition all .3s ease-in-out

.toc-list-item
  padding .1rem 0
  display -webkit-box
  -webkit-box-orient vertical
  -webkit-line-clamp 2
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

  &.is-active-li::before
    height 1rem
    margin 0.25rem 0
    visibility visible

  &::before
    width 0.15rem
    height 0.2rem
    position absolute
    left 0.25rem
    content ""
    border-radius 2px
    margin 0.65rem 0
    background var(--link-hover-color)
    visibility hidden
    transition height .1s ease-in-out, margin .1s ease-in-out, visibility .1s ease-in-out

.sidebar
  position -webkit-sticky
  position sticky
  top 2rem
  padding 3rem 0

button.toc-toggle
  border 0
  background transparent
  padding 0
  font-family inherit

button.toc-toggle:focus-visible, .tocbot-link:focus-visible
  outline 2px solid var(--link-hover-color)
  outline-offset 2px

.mobile-toc-toggle
  position fixed
  bottom calc(1rem + env(safe-area-inset-bottom, 0px))
  right 1rem
  z-index 1030
  border 1px solid var(--line-color)
  border-radius 1.5rem
  background var(--board-bg-color)
  color var(--text-color)
  padding .65rem 1rem
  box-shadow 0 2px 12px rgba(0, 0, 0, .15)
  cursor pointer

.mobile-toc-toggle[hidden]
  display none !important

.mobile-toc-toggle:focus-visible
  outline 2px solid var(--link-hover-color)
  outline-offset 3px

#mobile-toc-dialog
  .modal-content
    background var(--board-bg-color)
    color var(--text-color)

  .modal-header
    border-color var(--line-color)

  .close
    color var(--text-color)

  .toc-header
    display none

  .toc-body
    max-height 65vh
    overflow-x auto
    padding .25rem

  .tocbot-list a
    font-size 1rem

  .toc-list-item
    padding .3rem 0

  button.toc-toggle
    min-width 1.75rem
    min-height 1.75rem

  .toc-toggle-placeholder
    width 1.75rem

@media print
  #mobile-toc-toggle, #mobile-toc-dialog
    display none !important
